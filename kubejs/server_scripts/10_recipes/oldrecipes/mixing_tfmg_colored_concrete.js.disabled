ServerEvents.recipes(event => {
  const colors = [
    'white',
    'blue',
    'light_blue',
    'red',
    'green',
    'lime',
    'pink',
    'magenta',
    'yellow',
    'gray',
    'light_gray',
    'brown',
    'cyan',
    'purple',
    'orange',
    'black'
  ]

  colors.forEach(color => {
    event.remove({ output: `tfmg:${color}_concrete` })

    event.recipes.createMixing(
      [Item.of(`tfmg:${color}_concrete`, 8)],
      [
        Item.of('tfmg:concrete', 8),
        `minecraft:${color}_dye`
      ]
    )
  })
})
