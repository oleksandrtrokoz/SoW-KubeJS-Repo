ServerEvents.recipes(event => {
  event.remove({ output: 's_a_b:steelblockstone' })

  event.shapeless(
    Item.of('s_a_b:steelblockstone', 8),
    [
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      '#createbigcannons:block_steel',
      'minecraft:clay_ball'
    ]
  )
})
